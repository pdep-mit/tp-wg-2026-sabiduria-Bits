import wollok.game.*
import serpiente.*
import direccion.*
import obstaculo.*

describe "Probando cómo interactúa con los obstáculos" {

    const piedra = new Piedra(position = game.at(10, 10))
    const cactus = new Cactus(position = game.at(5, 10))
    const lava = new Lava(position = game.at(10, 5))

    method initialize() {
        game.width(40)
        game.height(40)
    }

    test "Chocar contra la piedra es letal para la serpiente" {
        serpiente.resetear()
        piedra.chocarCon(serpiente)
        assert.notThat(serpiente.estaViva())
    }

    test "Chocar contra el cactus no la mata pero le baja puntos y velocidad" {
        serpiente.resetear()
        serpiente.puntaje(50)
        serpiente.velocidad(20) // Velocidad base
        
        cactus.chocarCon(serpiente)
        
        assert.that(serpiente.estaViva())          // Sigue viva
        assert.equals(45, serpiente.puntaje())     // 50 - 5 = 45
        assert.equals(40, serpiente.velocidad())   // 20 * 2 = 40 (va más lento)
    }

    test "La lava no la mata pero le resta 10 puntos y quema un segmento del cuerpo" {
        serpiente.resetear()
        serpiente.puntaje(50)
        serpiente.crecer()
        assert.equals(1, serpiente.cuerpo().size())

        lava.chocarCon(serpiente)
        
        assert.that(serpiente.estaViva())         // Sigue viva
        assert.equals(40, serpiente.puntaje())    // 50 - 10 = 40
        assert.that(serpiente.cuerpo().isEmpty()) // Perdió el segmento
    }
}