import wollok.game.*
import serpiente.*
import direccion.*
import obstaculo.*

describe "Probando cómo interactúa con los obstáculos" {

    const piedra = new Piedra(position = game.at(10, 10))
    const cactus = new Cactus(position = game.at(5, 10))
    const lava = new Lava(position = game.at(10, 5))

    method initialize() {
        game.width(40)
        game.height(40)
    }

    test "Chocar contra la piedra es letal para la serpiente" {
        serpiente.resetear()
        piedra.chocarCon(serpiente)
        assert.notThat(serpiente.estaViva())
    }

    test "Chocar contra el cactus es letal para la serpiente" {
        serpiente.resetear()
        cactus.chocarCon(serpiente)
        assert.notThat(serpiente.estaViva())
    }

    test "La lava también es letal y ademas le roba todos los puntos" {
        serpiente.resetear()
        serpiente.puntaje(50)
        lava.chocarCon(serpiente)
        
        assert.notThat(serpiente.estaViva())
        assert.equals(0, serpiente.puntaje())
    }
}