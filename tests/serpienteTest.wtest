import wollok.game.*
import serpiente.*
import direccion.*

describe "probando como se mueve y vive la viborita" {
    
    method initialize() {
        game.width(16)
        game.height(16)
        serpiente.velocidad(1)
        serpiente.reanudar()
    }

    test "si le digo q avance a la derecha suma en x" {
        serpiente.position(game.at(2, 2))
        serpiente.direccion(derecha)
        serpiente.avanzar()
        assert.equals(game.at(3, 2), serpiente.position())
    }
    
    test "si avanza pa la izquierda resta en x" {
        serpiente.position(game.at(2, 2))
        serpiente.direccion(izquierda)
        serpiente.avanzar()
        assert.equals(game.at(1, 2), serpiente.position())
    }
    
    test "si va para arriva suma en y" {
        serpiente.position(game.at(2, 2))
        serpiente.direccion(arriba)
        serpiente.avanzar()
        assert.equals(game.at(2, 3), serpiente.position()) 
    }

    test "no puede hacer un giro de 180 grados de una porque se rompe el cuello" {
        serpiente.direccion(derecha)
        serpiente.avanzar() 
        serpiente.cambiarDireccion(izquierda)
        // tiene q ignorar el cambio y seguir pa la derecha
        assert.equals(derecha, serpiente.direccion())
    }
    
    test "se choca la pared derecha y se re muere" {
        serpiente.position(game.at(15, 2))
        serpiente.direccion(derecha)
        serpiente.avanzar()
        assert.notThat(serpiente.estaViva())
    }

    test "se choca abajo y palma" {
        serpiente.position(game.at(2, 0))
        serpiente.direccion(abajo)
        serpiente.avanzar()
        assert.notThat(serpiente.estaViva())
    }
    
    test "si la reseteo vuelve al diome y revive sin puntos" {
        serpiente.position(game.at(10, 10))
        serpiente.puntaje(50)
        serpiente.morir()
        
        serpiente.resetear()
        
        assert.equals(game.at(5, 5), serpiente.position())
        assert.equals(0, serpiente.puntaje())
        assert.that(serpiente.estaViva())
    }
}