import serpiente.*
import comida.*
import segmento.*
import colisionable.*
import wollok.game.*
import nivel.*

describe "probando los choques y colisiones de la serpiente" {

    method initialize() {
        game.width(16)
        game.height(16)
        // cargamos el nivel pa q el gestor no tire error al buscar pos libre
        gestorDeNiveles.cargarNivelActual()
    }

    test "si choca con la manzana la come y la manzana se va a otro lado" {
        const unaManzana = new Manzana(position = game.at(5, 5))
        
        serpiente.position(game.at(5, 5))
        colision.colisionar(unaManzana)
        
        // verifico q la manzana ya no este ahi
        assert.notEquals(game.at(5, 5), unaManzana.position())
    }

    test "si es muy larga y se muerde la cola se muere" {
        serpiente.position(game.at(5, 5))
        const unCachoDeCuerpo = new Segmento(position = game.at(5, 5))
        
        colision.colisionar(unCachoDeCuerpo)
        
        assert.notThat(serpiente.estaViva())
    }
}