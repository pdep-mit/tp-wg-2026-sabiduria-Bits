import comida.*
import obstaculo.*
import serpiente.*
import colisionable.*
import wollok.game.*
import nivel.*

describe "testeando q las frutas del puntaje y los obstaculos" {

    const piedra = new Piedra(position = game.at(10, 10))
    const cactus = new Cactus(position = game.at(5, 10))
    const lava = new Lava(position = game.at(10, 5))

    method initialize() {
        game.width(16)
        game.height(16)
        serpiente.resetear()
        gestorDeNiveles.cargarNivelActual()
    }

    test "la banana te da 20 puntitos y te hace mas rapido" {
        const banana = new Banana(position = game.at(5, 5))
        serpiente.position(game.at(5, 5))

        colision.colisionar(banana)

        assert.equals(20, serpiente.puntaje())
        // La velocidad arranca en 20. La banana ahora resta 2 (por el super + su propio 1)
        assert.equals(18, serpiente.velocidad()) 
    }

    test "la fruta dorada esta chetada y da 50 puntos" {
        const dorada = new FrutaDorada(position = game.at(5, 5))
        colision.colisionar(dorada)
        
        assert.equals(50, serpiente.puntaje())
    }

    test "chocar contra una piedra te liquida" {
        piedra.chocarCon(serpiente)
        assert.notThat(serpiente.estaViva())
    }

    test "chocar contra un cactus NO te mata pero te resta puntos y velocidad" {
        // Preparamos a la serpiente con puntos y velocidad normal
        serpiente.puntaje(50)
        serpiente.velocidad(20)
        
        cactus.chocarCon(serpiente)
        
        // Verificamos la nueva lógica del Cactus
        assert.that(serpiente.estaViva())            // Sigue viva
        assert.equals(45, serpiente.puntaje())       // Perdió 5 puntos
        assert.equals(40, serpiente.velocidad())     // Se frenó (20 * 2 = 40)
    }

    test "pisar la lava NO te mata, te resta 10 puntos y te quema un segmento del cuerpo" {
            serpiente.puntaje(500)
            serpiente.crecer() // Agregamos 1 segmento para verificar que la lava lo quema
            assert.equals(1, serpiente.cuerpo().size())

            lava.chocarCon(serpiente)
            
            assert.that(serpiente.estaViva())            // Sigue viva
            assert.equals(490, serpiente.puntaje())      // Perdió 10 puntos (500 - 10)
            assert.that(serpiente.cuerpo().isEmpty())    // Perdió el segmento que tenía
    }
}