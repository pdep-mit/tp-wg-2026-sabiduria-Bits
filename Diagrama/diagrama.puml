@startuml DiagramaEstaticoSnake

' --- CLASES Y JERARQUIA ---
class ElementoDeJuego {
  -position: Position
  +image()
  +chocarCon(serpiente)
  +reposicionar(serpiente)
  +posicionLibre(pos, serpiente): Boolean
}

class Comida extends ElementoDeJuego {
  +puntaje(): Number
  +aumentarRapidez(serpiente)
  +chocarCon(serpiente)
  +resetear()
}

class Manzana extends Comida {
  +puntaje(): Number
  +image(): String
}

class Banana extends Comida {
  +puntaje(): Number
  +image(): String
  +aumentarRapidez(serpiente)
}

class Cereza extends Comida {
  +puntaje(): Number
  +image(): String
  +aumentarRapidez(serpiente)
}

class FrutaDorada extends Comida {
  +puntaje(): Number
  +image(): String
  +aumentarRapidez(serpiente)
}

class Obstaculo extends ElementoDeJuego {
  +chocarCon(serpiente)
}

class Piedra extends Obstaculo {
  +image(): String
}

class Cactus extends Obstaculo {
  +image(): String
  +chocarCon(serpiente)
}

class Lava extends Obstaculo {
  +image(): String
  +chocarCon(serpiente)
}

class Segmento {
  -position: Position
  +image(): String
  +chocarCon(serpiente)
}

class Nivel {
  -elementos: List<ElementoDeJuego>
  -puntajeObjetivo: Number
  -imagen: String
  +iniciar()
  +terminar()
  +ocupa(posicion, elementoIgnorado): Boolean
}

' --- OBJETOS (WKO) ---
object serpiente <<object>> {
  -position: Position
  -direccion
  -direccionActual
  -puntaje: Number
  -velocidad: Number
  -contador: Number
  -viva: Boolean
  -pausada: Boolean
  -cuerpo: List<Segmento>
  +cambiarDireccion(nuevaDireccion)
  +avanzar()
  +moverCuerpo(posCabezaAnterior)
  +verificarBorde()
  +comer(comida)
  +aumentarVelocidad(cuanto)
  +restarPuntaje(cantidad)
  +reducirVelocidadALaMitad()
  +crecer()
  +ocupa(unaPosicion): Boolean
  +pausar()
  +reanudar()
  +resetear()
  +morir()
  +estaViva(): Boolean
  +image(): String
}

object gestorDeNiveles <<object>> {
  -indiceNivelActual: Number
  -niveles: List<Nivel>
  +nivelActual(): Nivel
  +tiempoDeJuego(): Number
  +verificarProgreso(puntajeActual)
  +efectoFinDelJuego()
  +iniciarJuego()
  +efectoTransicion()
  +mostrarPantallaTransicion()
  +cargarNivelActual()
  +resetear()
}

object marcador <<object>> {
  +position(): Position
  +text(): String
  +textColor(): String
  +chocarCon(serpiente)
}

object controles <<object>> {
  +configurar()
}

object colision <<object>> {
  +colisionar(objeto)
}

object arriba <<object>> {
  +siguientePosicion(posicion)
  +opuesta()
}

object abajo <<object>> {
  +siguientePosicion(posicion)
  +opuesta()
}

object izquierda <<object>> {
  +siguientePosicion(posicion)
  +opuesta()
}

object derecha <<object>> {
  +siguientePosicion(posicion)
  +opuesta()
}

object pantallaGameOver <<object>> {
  +position(): Position
  +image(): String
}

object pantallaFinDelJuego <<object>> {
  +position(): Position
  +image(): String
}

object pantallaTransicion <<object>> {
  +position(): Position
  +image(): String
}

' --- CONOCE (---> : referencia guardada en un atributo) ---
Nivel ---> ElementoDeJuego : elementos
gestorDeNiveles ---> Nivel : niveles
serpiente ---> Segmento : cuerpo
serpiente ---> derecha : direccion / direccionActual

' --- USA (..> : parametro, llamada o uso temporal) ---
ElementoDeJuego ..> serpiente
ElementoDeJuego ..> gestorDeNiveles
Comida ..> serpiente
Obstaculo ..> serpiente
Segmento ..> serpiente
Nivel ..> serpiente

gestorDeNiveles ..> serpiente
gestorDeNiveles ..> pantallaTransicion
gestorDeNiveles ..> pantallaFinDelJuego

serpiente ..> gestorDeNiveles
serpiente ..> pantallaGameOver
serpiente ..> Comida
serpiente ..> arriba
serpiente ..> abajo
serpiente ..> izquierda
serpiente ..> derecha

marcador ..> serpiente
controles ..> serpiente
controles ..> gestorDeNiveles
controles ..> arriba
controles ..> abajo
controles ..> izquierda
controles ..> derecha

colision ..> serpiente
pantallaTransicion ..> gestorDeNiveles

arriba ..> abajo : opuesta()
abajo ..> arriba : opuesta()
izquierda ..> derecha : opuesta()
derecha ..> izquierda : opuesta()

note bottom of colision
  El parametro "objeto" no tiene un tipo declarado
  en el codigo, por eso no se agrega una relacion
  hacia una clase concreta.
end note

note bottom of ElementoDeJuego
  Position pertenece a wollok.game,
  una biblioteca externa al proyecto.
end note

@enduml