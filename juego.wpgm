import wollok.game.*
import example.* // no es necesario
import serpiente.*
import comida.*
import direccion.*


program Snake {
    // TODO: Cambiar esto por lo que necesiten
    game.title("Grupo: Bits | Nombre de jueguito")
    game.height(40)
    game.width(40)


    // Agregar visuales
    game.addVisual(serpiente)
    game.addVisual(comida)


   
   
    // Eventos de teclado (Usar game.onKeyPress)
    keyboard.w().onPressDo { serpiente.cambiarDireccion(arriba) }
    keyboard.s().onPressDo { serpiente.cambiarDireccion(abajo) }
    keyboard.a().onPressDo { serpiente.cambiarDireccion(izquierda) }
    keyboard.d().onPressDo { serpiente.cambiarDireccion(derecha) }


    keyboard.up().onPressDo { serpiente.cambiarDireccion(arriba) }
    keyboard.down().onPressDo { serpiente.cambiarDireccion(abajo) }
    keyboard.left().onPressDo { serpiente.cambiarDireccion(izquierda) }
    keyboard.right().onPressDo { serpiente.cambiarDireccion(derecha) }


    keyboard.r().onPressDo {
        serpiente.resetear()
        comida.resetear()
        game.start()
    }
   
    keyboard.f().onPressDo {
        // Salir: simplemente detener el juego (o cerrar la pestaña del navegador).
        game.stop()
    }
       
    // Evento temporal
    game.onTick(500, "moverSerpiente", { serpiente.avanzar() })
   
    // Colisiones
    game.onCollideDo(serpiente, { objeto => objeto.chocarCon(serpiente) })
    game.start()
}
