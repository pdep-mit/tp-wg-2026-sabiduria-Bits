import marcador.*
import wollok.game.*
import serpiente.*
import direccion.*
import nivel.*
import controles.*

program Snake {
    game.title("Grupo: Bits | Nombre de jueguito")
    game.height(16) 
    game.width(16)
    
    game.boardGround("fondo.png")

    game.addVisual(serpiente)
    game.addVisual(marcador)

    // nivel 1
    gestorDeNiveles.iniciarJuego()
   
    controles.configurar()
       
    game.onTick(20, "moverSerpiente", { serpiente.avanzar() })
   
    game.onCollideDo(serpiente, { objeto => objeto.chocarCon(serpiente) })
    
    game.start()
}